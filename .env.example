# Slack credentials. Never commit real token values.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# Fail-closed identity restrictions. Use Slack IDs, not display names.
SLACK_TEAM_ID=T_REPLACE_ME
ALLOWED_USER_IDS=U_REPLACE_ME
ALLOWED_CHANNEL_IDS=C_REPLACE_ME

# Codex operates only inside this repository and stays read-only.
WORKSPACE_ROOT=/absolute/path/to/a/git/repository
CODEX_BIN=/Users/example/.npm-global/bin/codex
AGY_BIN=/Users/example/.local/bin/agy

# Both are false by default. Enable execution first while posting remains false.
EXECUTION_ENABLED=false
POSTING_ENABLED=false

COMMAND_TIMEOUT_MS=300000
RATE_LIMIT_SECONDS=30
MAX_MEDIA_FILES=3
MAX_FILE_BYTES=52428800
MAX_OUTPUT_CHARS=12000
