{
  "name": "slack-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed Slack bridge for Codex CLI and AntiGravity CLI.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@slack/bolt": "5.0.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
